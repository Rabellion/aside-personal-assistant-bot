# ---- Heroku (the always-on bot) ----
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
OWNER_DISCORD_USER_ID=
OWNER_NAME=Huzaifa

# Subscription-based model auth
CLAUDE_CODE_OAUTH_TOKEN=
CODEX_AUTH_JSON_BASE64=
# Google retired subscription login for Gemini CLI, so this is an AI Studio key
GEMINI_API_KEY=

# Shared secret the local agent authenticates with. Must match on both sides.
AGENT_SHARED_SECRET=

# ---- local-agent.js (runs on your PC, NOT on Heroku) ----
BRIDGE_URL=wss://<your-heroku-app>.herokuapp.com/agent
# AGENT_SHARED_SECRET=   (same value as above)
# Optional: where the agent does its work. Defaults to your home directory.
AGENT_WORKDIR=
