# Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
OWNER_DISCORD_USER_ID=845391729549115402

# Claude Code (Claude Pro/Max subscription) - generate on YOUR machine with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Codex CLI (ChatGPT subscription) - generate on YOUR machine with:
#   codex login            (or: codex login --device-auth on a headless machine)
# then base64-encode the resulting ~/.codex/auth.json:
#   macOS/Linux:  base64 -i ~/.codex/auth.json
#   Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("$HOME\.codex\auth.json"))
CODEX_AUTH_JSON_BASE64=

# Gemini CLI (Gemini subscription) - generate on YOUR machine with:
#   gemini    (complete the browser login once)
# then find and base64-encode its credentials file (path varies by version,
# commonly ~/.gemini/oauth_creds.json) the same way as above.
GEMINI_AUTH_JSON_BASE64=
GEMINI_AUTH_JSON_PATH=
